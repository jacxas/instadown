# Entorno
NODE_ENV=development
PORT=3000

# URL pública del sitio (se usa para los redirects de Stripe)
APP_URL=http://localhost:3000

# Secreto para firmar la cookie de sesión (obligatorio en producción).
# Generar con: openssl rand -hex 32
SESSION_SECRET=

# Pagos: disabled | stripe | mock (mock solo en desarrollo)
PAYMENTS_PROVIDER=stripe
PREMIUM_PRICE_CENTS=100
PREMIUM_PRICE_CURRENCY=usd
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Opcional: usar un Price creado en el dashboard en vez de precio inline
STRIPE_PRICE_ID=

# Cuota gratuita por día
FREE_DAILY_LIMIT=2

# Instagram (cuenta dedicada; sin credenciales el acceso es anónimo y limitado)
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# Datos y archivos
DATA_DIR=./data
DOWNLOADS_DIR=./downloads

# Administración (si se define, habilita POST /api/admin/grant con header X-Admin-Token)
ADMIN_TOKEN=

# CORS: dejar vacío para same-origin (recomendado)
CORS_ORIGINS=
