{
  "name": "instadown-pro",
  "version": "2.1.0",
  "description": "Instagram Downloader - Descarga contenido de Instagram de forma nativa",
  "main": "server.js",
  "engines": {
    "node": ">=18.17"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test --test-timeout=20000 test/*.test.js",
    "check": "node --check server.js && node --check src/app.js && node --check public/app.js",
    "python:check": "python3 -m py_compile instagram_downloader.py python_backend.py"
  },
  "keywords": [
    "instagram",
    "downloader",
    "video",
    "photo",
    "stories",
    "reels"
  ],
  "author": "Jacxas",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2"
  }
}
